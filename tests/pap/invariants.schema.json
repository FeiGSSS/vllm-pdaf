{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm.ai/schemas/pap-test-invariants-v2.json",
  "title": "PAP test invariant registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory",
    "namespaces",
    "retired_tests",
    "invariants",
    "test_audit",
    "audit_summary"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "namespaces": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "protocol",
          "topology",
          "lifecycle",
          "kv",
          "attention",
          "transport",
          "integration",
          "launcher",
          "benchmark-validator"
        ]
      }
    },
    "retired_tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/retiredTest"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "test_audit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/testAudit"
      }
    },
    "audit_summary": {
      "$ref": "#/$defs/auditSummary"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "collected_at",
        "collection_targets",
        "excluded_owner_paths",
        "collected_count",
        "passed_count",
        "skipped_count",
        "total_duration_ms",
        "timing_scope"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "collected_at": {
          "type": "string",
          "format": "date"
        },
        "collection_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "excluded_owner_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "collected_count": {
          "type": "integer",
          "minimum": 1
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "timing_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "commit",
            "experiment"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    "retiredTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "removed_at",
        "task",
        "reason",
        "replacement_node_ids"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^tests/.+::.+$"
        },
        "removed_at": {
          "type": "string",
          "format": "date"
        },
        "task": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 20
        },
        "replacement_node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tests/.+::.+$"
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "level",
        "source_owners",
        "node_ids",
        "regressions",
        "required",
        "coverage_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(protocol|topology|lifecycle|kv|attention|transport|integration|launcher|benchmark-validator)\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "statement": {
          "type": "string",
          "minLength": 20
        },
        "level": {
          "enum": [
            "unit",
            "contract",
            "integration",
            "gpu",
            "benchmark"
          ]
        },
        "source_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "node_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tests/.+::.+$"
          }
        },
        "regressions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/regression"
          }
        },
        "required": {
          "type": "boolean"
        },
        "coverage_status": {
          "enum": [
            "protected",
            "preserved-unverified",
            "retiring"
          ]
        }
      }
    },
    "testAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "owner_path",
        "source_owner",
        "duration_ms",
        "outcome",
        "invariant_ids",
        "disposition",
        "reason",
        "target_path"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^tests/.+::.+$"
        },
        "owner_path": {
          "$ref": "#/$defs/relativePath"
        },
        "source_owner": {
          "$ref": "#/$defs/relativePath"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "passed",
            "skipped"
          ]
        },
        "invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "disposition": {
          "enum": [
            "keep",
            "merge",
            "rewrite",
            "delete",
            "move"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 16
        },
        "target_path": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "auditSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "by_disposition"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "by_disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "keep",
            "merge",
            "rewrite",
            "delete",
            "move"
          ],
          "properties": {
            "keep": {
              "type": "integer",
              "minimum": 0
            },
            "merge": {
              "type": "integer",
              "minimum": 0
            },
            "rewrite": {
              "type": "integer",
              "minimum": 0
            },
            "delete": {
              "type": "integer",
              "minimum": 0
            },
            "move": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
