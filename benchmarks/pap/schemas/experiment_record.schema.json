{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm.ai/schemas/pap-experiment-record-v1.json",
  "title": "PAP experiment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "experiment_id",
    "title",
    "recorded_at",
    "hypothesis",
    "evidence",
    "decision",
    "validity",
    "baseline",
    "treatment",
    "primary_variable",
    "run_ids",
    "aggregation_method",
    "metrics",
    "conclusion",
    "supersedes",
    "superseded_by",
    "raw_artifacts",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "pap-experiment-record"
    },
    "status": {
      "enum": [
        "current",
        "archived"
      ]
    },
    "experiment_id": {
      "$ref": "#/$defs/experimentId"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "recorded_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date",
          "not": {
            "const": "missing"
          }
        },
        {
          "const": "missing"
        }
      ]
    },
    "hypothesis": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "baseline": {
      "$ref": "#/$defs/arm"
    },
    "treatment": {
      "$ref": "#/$defs/arm"
    },
    "primary_variable": {
      "$ref": "#/$defs/primaryVariable"
    },
    "run_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "aggregation_method": {
      "$ref": "#/$defs/stringOrMissing"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparisonMetric"
      }
    },
    "conclusion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/experimentId"
      }
    },
    "superseded_by": {
      "oneOf": [
        {
          "$ref": "#/$defs/experimentId"
        },
        {
          "type": "null"
        },
        {
          "const": "missing"
        }
      ]
    },
    "raw_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^PAP-[0-9]{8}-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringOrMissing": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "missing"
          }
        },
        {
          "const": "missing"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digestOrMissing": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "const": "missing"
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pathReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "relative_path"
      ],
      "properties": {
        "root_id": {
          "$ref": "#/$defs/stableId"
        },
        "relative_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "sha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "$ref": "#/$defs/pathReference"
        },
        "sha256": {
          "$ref": "#/$defs/digestOrMissing"
        }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "description",
        "run_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "present",
            "missing",
            "not-applicable"
          ]
        },
        "description": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "run_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "variableValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "primaryVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "baseline",
        "treatment"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stableId"
        },
        "baseline": {
          "$ref": "#/$defs/variableValue"
        },
        "treatment": {
          "$ref": "#/$defs/variableValue"
        }
      }
    },
    "measurement": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "missing",
            "not-applicable"
          ]
        }
      ]
    },
    "comparisonMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "statistic",
        "unit",
        "baseline_value",
        "treatment_value",
        "direction"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stableId"
        },
        "scope": {
          "$ref": "#/$defs/stableId"
        },
        "statistic": {
          "$ref": "#/$defs/stableId"
        },
        "unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "baseline_value": {
          "$ref": "#/$defs/measurement"
        },
        "treatment_value": {
          "$ref": "#/$defs/measurement"
        },
        "direction": {
          "enum": [
            "lower-is-better",
            "higher-is-better",
            "descriptive"
          ]
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "invalid",
            "missing"
          ]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "evidence": {
      "enum": [
        "formal-clean",
        "controlled",
        "diagnostic",
        "smoke",
        "historical",
        "invalid"
      ]
    },
    "decision": {
      "enum": [
        "accepted",
        "optional",
        "rejected",
        "rolled-back",
        "superseded",
        "inconclusive"
      ]
    }
  }
}
