{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm.ai/schemas/pap-run-manifest-v1.json",
  "title": "PAP run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "experiment_id",
    "profile_id",
    "architecture",
    "mode",
    "evidence",
    "provenance",
    "workload",
    "topology",
    "placement",
    "transport",
    "mps",
    "runtime",
    "environment",
    "fingerprints",
    "repetitions",
    "audits",
    "metrics",
    "artifacts",
    "validity",
    "failure_reasons"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "pap-run-manifest"
    },
    "run_id": {
      "$ref": "#/$defs/stableId"
    },
    "experiment_id": {
      "$ref": "#/$defs/experimentId"
    },
    "profile_id": {
      "$ref": "#/$defs/stableId"
    },
    "architecture": {
      "enum": [
        "pap",
        "pd",
        "monolithic"
      ]
    },
    "mode": {
      "enum": [
        "formal",
        "controlled",
        "diagnostic",
        "quick",
        "smoke",
        "historical"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "workload": {
      "$ref": "#/$defs/workload"
    },
    "topology": {
      "$ref": "#/$defs/topology"
    },
    "placement": {
      "$ref": "#/$defs/placement"
    },
    "transport": {
      "$ref": "#/$defs/transport"
    },
    "mps": {
      "$ref": "#/$defs/mps"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "fingerprints": {
      "$ref": "#/$defs/fingerprints"
    },
    "repetitions": {
      "$ref": "#/$defs/repetitions"
    },
    "audits": {
      "$ref": "#/$defs/audits"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "failure_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^PAP-[0-9]{8}-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digestOrMissing": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "const": "missing"
        }
      ]
    },
    "stringOrMissing": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "missing"
          }
        },
        {
          "const": "missing"
        }
      ]
    },
    "numberOrMissing": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "const": "missing"
        }
      ]
    },
    "integerOrMissing": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "missing"
        }
      ]
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pathReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_id",
        "relative_path"
      ],
      "properties": {
        "root_id": {
          "$ref": "#/$defs/stableId"
        },
        "relative_path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": [
            "result",
            "aggregate",
            "manifest",
            "configuration",
            "audit",
            "metrics",
            "log",
            "trace",
            "profile",
            "patch",
            "other"
          ]
        },
        "path": {
          "$ref": "#/$defs/pathReference"
        },
        "sha256": {
          "$ref": "#/$defs/digestOrMissing"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "tracked_worktree_dirty",
        "tracked_worktree_patch_sha256",
        "tracked_index_patch_sha256",
        "started_at"
      ],
      "properties": {
        "branch": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "const": "missing"
            }
          ]
        },
        "tracked_worktree_dirty": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "missing"
            }
          ]
        },
        "tracked_worktree_patch_sha256": {
          "$ref": "#/$defs/digestOrMissing"
        },
        "tracked_index_patch_sha256": {
          "$ref": "#/$defs/digestOrMissing"
        },
        "started_at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "const": "missing"
            }
          ]
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "corpus",
        "parameters"
      ],
      "properties": {
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "dtype",
            "tensor_parallel_size"
          ],
          "properties": {
            "path": {
              "oneOf": [
                {
                  "$ref": "#/$defs/pathReference"
                },
                {
                  "const": "missing"
                }
              ]
            },
            "dtype": {
              "$ref": "#/$defs/stringOrMissing"
            },
            "tensor_parallel_size": {
              "$ref": "#/$defs/integerOrMissing"
            }
          }
        },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "oneOf": [
                {
                  "$ref": "#/$defs/pathReference"
                },
                {
                  "const": "missing"
                }
              ]
            },
            "sha256": {
              "$ref": "#/$defs/digestOrMissing"
            }
          }
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "pa_count",
        "projection_count",
        "pd_prefill_count",
        "pd_decode_count",
        "routing_policy"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "pa_count": {
          "$ref": "#/$defs/integerOrMissing"
        },
        "projection_count": {
          "$ref": "#/$defs/integerOrMissing"
        },
        "pd_prefill_count": {
          "$ref": "#/$defs/integerOrMissing"
        },
        "pd_decode_count": {
          "$ref": "#/$defs/integerOrMissing"
        },
        "routing_policy": {
          "$ref": "#/$defs/stringOrMissing"
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefill_devices",
        "attention_devices",
        "projection_devices",
        "decode_devices"
      ],
      "properties": {
        "prefill_devices": {
          "$ref": "#/$defs/deviceList"
        },
        "attention_devices": {
          "$ref": "#/$defs/deviceList"
        },
        "projection_devices": {
          "$ref": "#/$defs/deviceList"
        },
        "decode_devices": {
          "$ref": "#/$defs/deviceList"
        }
      }
    },
    "deviceList": {
      "oneOf": [
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        {
          "const": "missing"
        }
      ]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offload_exec",
        "offload_kv",
        "same_host"
      ],
      "properties": {
        "offload_exec": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "offload_kv": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "same_host": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "const": "missing"
            }
          ]
        }
      }
    },
    "mps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "profile_id",
        "prefill_visible_sms",
        "attention_visible_sms"
      ],
      "properties": {
        "mode": {
          "enum": [
            "static",
            "dynamic",
            "disabled",
            "missing"
          ]
        },
        "profile_id": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "prefill_visible_sms": {
          "$ref": "#/$defs/integerOrMissing"
        },
        "attention_visible_sms": {
          "$ref": "#/$defs/integerOrMissing"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "settings"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "settings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_signature",
        "software",
        "fingerprint_basis"
      ],
      "properties": {
        "hardware_signature": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "software": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/stringOrMissing"
          }
        },
        "fingerprint_basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "implementation",
        "request_shape",
        "hardware_runtime"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/digestOrMissing"
        },
        "implementation": {
          "$ref": "#/$defs/digestOrMissing"
        },
        "request_shape": {
          "$ref": "#/$defs/digestOrMissing"
        },
        "hardware_runtime": {
          "$ref": "#/$defs/digestOrMissing"
        }
      }
    },
    "repetitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "order",
        "aggregation_method",
        "items"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "aggregation_method": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "repetition_id",
              "result_artifact"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "repetition_id": {
                "$ref": "#/$defs/stringOrMissing"
              },
              "result_artifact": {
                "$ref": "#/$defs/pathReference"
              }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "missing",
            "not-applicable"
          ]
        },
        "detail": {
          "$ref": "#/$defs/stringOrMissing"
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathReference"
          }
        }
      }
    },
    "audits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client",
        "cache",
        "attention_stats",
        "correctness",
        "decode_token_join",
        "routing",
        "commit",
        "lease",
        "session_drain",
        "mps"
      ],
      "properties": {
        "client": {
          "$ref": "#/$defs/gate"
        },
        "cache": {
          "$ref": "#/$defs/gate"
        },
        "attention_stats": {
          "$ref": "#/$defs/gate"
        },
        "correctness": {
          "$ref": "#/$defs/gate"
        },
        "decode_token_join": {
          "$ref": "#/$defs/gate"
        },
        "routing": {
          "$ref": "#/$defs/gate"
        },
        "commit": {
          "$ref": "#/$defs/gate"
        },
        "lease": {
          "$ref": "#/$defs/gate"
        },
        "session_drain": {
          "$ref": "#/$defs/gate"
        },
        "mps": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "statistic",
        "unit",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/stableId"
        },
        "scope": {
          "$ref": "#/$defs/stableId"
        },
        "statistic": {
          "$ref": "#/$defs/stableId"
        },
        "unit": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "$ref": "#/$defs/numberOrMissing"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_requests",
        "failed_requests",
        "values"
      ],
      "properties": {
        "completed_requests": {
          "$ref": "#/$defs/integerOrMissing"
        },
        "failed_requests": {
          "$ref": "#/$defs/integerOrMissing"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "invalid",
            "missing"
          ]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "evidence": {
      "enum": [
        "formal-clean",
        "controlled",
        "diagnostic",
        "smoke",
        "historical",
        "invalid"
      ]
    }
  }
}
