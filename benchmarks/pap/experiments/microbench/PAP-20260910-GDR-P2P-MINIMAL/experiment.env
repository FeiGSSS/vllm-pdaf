# Frozen settings for the minimal GPUDirect P2P RDMA repro.
#
# Mirrors the production cross-host PAP PD transport except that the model,
# vLLM, Dynamo, etcd and the request router are removed. The transport stack
# (NIXL + UCX 1.22 + libplugin_UCX.so + RC over InfiniBand) is unchanged.

PAP_MINIMAL_SRC_HOST=NF5468-L20T
PAP_MINIMAL_SRC_UCX_DEVICE=mlx5_0:1
PAP_MINIMAL_SINK_HOST=NF5468-L20B
PAP_MINIMAL_SINK_UCX_DEVICE=ibp49s0:1

# Data path under test: sink issues NIXL READ, payload lands in sink memory.
PAP_MINIMAL_CHUNK_MB=1400
PAP_MINIMAL_NUM_DESCS=1
PAP_MINIMAL_MAX_INFLIGHT=8
PAP_MINIMAL_DURATION_S=180
# Production KV ingest observed ~24 GB/s and ~1.4 GB per transfer, and the
# failure window opened 28-40 s after traffic start.

# Control arm uses the same settings with --where cpu.
PAP_MINIMAL_TREATMENT_WHERE=cuda
PAP_MINIMAL_CONTROL_WHERE=cpu
