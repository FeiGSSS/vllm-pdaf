#!/usr/bin/env bash

export MODEL_PATH=/data/ssd1/llm-models/Qwen3-8B
export PAP_TOPOLOGY=7pa1p
export PAP_PREFILL_GPUS=0,1,2,3,4,5,6
export PAP_PROJECTION_GPUS=7
export PAP_ROUTING_POLICY=dynamo
export PAP_ATTENTION_KERNEL_POLICY=auto
export PAP_NVSHMEM_PREFIX="${PAP_ROOT}/.local/nvshmem-3.3.24-cuda13"
export PAP_NVSHMEM_GPU_ARCH=sm_89
export PAP_PREFILL_MAX_NUM_BATCHED_TOKENS=2048
export PAP_PREFILL_MAX_NUM_SEQS=256
export PAP_PROJECTION_MAX_NUM_BATCHED_TOKENS=2048
export PAP_PROJECTION_MAX_NUM_SEQS=256
export PAP_PROJECTION_ASYNC_SCHEDULING=on
export MAX_MODEL_LEN=131072
export PAP_HF_OVERRIDES='{"rope_parameters":{"rope_type":"yarn","factor":4.0,"original_max_position_embeddings":32768}}'
export PAP_PREFILL_GPU_MEMORY_UTILIZATION=0.90
export PROJECTION_GPU_MEMORY_UTILIZATION=0.90
export PAP_TP_SIZE=1
export PAP_BLOCK_SIZE=16
export PAP_AIPERF_TIMING_MODE=request_rate
export PAP_AIPERF_REQUEST_RATE=0.9
export PAP_AIPERF_ARRIVAL_PATTERN=poisson
export PAP_AIPERF_WARMUP_DURATION_SECONDS=0
export BENCH_TIMEOUT=2400
export SERVER_START_TIMEOUT=900
export AIPERF_RANDOM_SEED=42
